# ─────────────────────────────────────────────────────────────
#  True Arm Construction — environment configuration
#  Copy to .env and fill in. These values are baked into the
#  static build, so set them BEFORE `npm run generate`.
#  Everything here is public by nature (runs in the browser).
#  Never put secret API keys or server credentials in this file.
# ─────────────────────────────────────────────────────────────

# Production domain (no trailing slash). Used for canonicals, sitemap, Open Graph, JSON-LD.
NUXT_PUBLIC_SITE_URL=https://truearmconstruction.com

# "production" enables indexing (robots meta + robots.txt). Anything else = noindex everywhere.
# Leave unset on Cloudflare Workers Builds: builds of the main branch are production automatically.
NUXT_PUBLIC_SITE_ENV=development

# Form delivery: "formspree" (default) or "webhook" (any HTTPS endpoint that accepts JSON POST).
NUXT_PUBLIC_FORM_PROVIDER=formspree
# Formspree form endpoint, e.g. https://formspree.io/f/abcdwxyz . Empty = forms show "not connected".
NUXT_PUBLIC_FORM_ENDPOINT=

# Analytics (all optional; nothing loads when empty). See docs/ANALYTICS.md
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_GA4_ID=
NUXT_PUBLIC_GOOGLE_ADS_ID=
NUXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Google Consent Mode v2 default: "granted" or "denied" (use "denied" with a consent banner/CMP)
NUXT_PUBLIC_ANALYTICS_CONSENT_DEFAULT=granted

# Google Search Console HTML-tag verification code (content value only)
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
